# ============================================================
# ProjectHub – Backend Environment Variables (Render)
# ============================================================
# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard.
# ============================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/projecthub?retryWrites=true&w=majority

# JWT secret — use a long, random string in production
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d

# ============================================================
# CORS — set this to your Vercel frontend URL (no trailing slash)
# Multiple origins can be comma-separated
# Example: https://projecthub.vercel.app,https://www.projecthub.vercel.app
# ============================================================
CLIENT_URL=https://your-app.vercel.app

# ============================================================
# Admin seed credentials — used only during first-time DB seed
# ============================================================
ADMIN_EMAIL=admin@projecthub.edu
ADMIN_PASSWORD=Admin@123456

# ============================================================
# Cloudinary (optional — leave blank to use local file storage)
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
