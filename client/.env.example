# ============================================================
# ProjectHub – Frontend Environment Variables (Vercel)
# ============================================================
# Copy this file to .env for local development.
# On Vercel, set these as Environment Variables in the project settings.
# ============================================================

# ============================================================
# CRITICAL: Include the /api suffix in the URL.
# Wrong:   VITE_API_URL=https://projecthub-api.onrender.com
# Correct: VITE_API_URL=https://projecthub-api.onrender.com/api
# ============================================================
VITE_API_URL=https://your-backend.onrender.com/api
