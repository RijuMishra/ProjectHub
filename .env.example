# ProjectHub Environment Variables Configuration
PORT=5000
# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/projecthub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/projecthub

# JWT Authentication Secret
JWT_SECRET=projecthub_jwt_super_secret_key_2026_academic_demo
JWT_EXPIRES_IN=7d

# Initial Admin Account Credentials (Auto-seeded on startup)
ADMIN_EMAIL=admin@projecthub.edu
ADMIN_PASSWORD=Admin@123456

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Storage Credentials (If omitted, local uploads storage is automatically used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NODE_ENV=development
